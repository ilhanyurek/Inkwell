<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_document"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_document"
        android:shortcutShortLabel="@string/new_document">
        <intent
            android:action="com.office.app.action.SHORTCUT"
            android:targetPackage="com.inkwell.app"
            android:targetClass="com.office.app.MainActivity">
            <extra android:name="target" android:value="new_document" />
